{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "colcon: build",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cd ~/fra532_ws && colcon build --symlink-install"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "source overlay",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source /opt/ros/$ROS_DISTRO/setup.bash && source ~/fra532_ws/install/setup.bash && echo 'overlay sourced'"
      ],
      "problemMatcher": []
    }
  ]
}